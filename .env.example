# ==============================================================================
# Mr. Beast AI — Environment Configuration Template
# Copy this file to .env and configure your secrets/credentials
# ==============================================================================

# Database Configuration (MySQL / phpMyAdmin)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mr_beast_db

# Conversational AI Providers
# Primary provider options: 'ollama', 'groq', 'gemini', 'openrouter'
PRIMARY_AI_PROVIDER=ollama
FALLBACK_AI_PROVIDER=none
ALLOW_PAID_FALLBACK=false
REQUEST_TIMEOUT_SECONDS=60

# Local Ollama API (Zero cost, local inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Groq API (Ultra-fast LLM & STT, free tier available at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3

# Google Gemini API (Free tier available at https://ai.google.dev)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter API (Access to open models at https://openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Speech Recognition (STT)
# Providers: 'faster_whisper', 'google', 'groq'
STT_PROVIDER=google
STT_LANGUAGE=auto
FASTER_WHISPER_MODEL=small

# Text-to-Speech (TTS)
# Providers: 'pyttsx3', 'piper', 'google_cloud'
TTS_PROVIDER=pyttsx3
TTS_RATE=160
TTS_VOLUME=0.9

# Third-Party Demographic APIs
AGIFY_ENABLED=true
HUGGINGFACE_API_TOKEN=

# Privacy & Security Settings
STORE_FULL_TRANSCRIPTS=false
REQUIRE_PROFILE_CONFIRMATION=true
REQUIRE_PHOTO_CONSENT=true
REQUIRE_BIOMETRIC_CONSENT=true
